# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Enable after files:registerUpload is deployed to this Convex deployment.
VITE_CONVEX_UPLOAD_REGISTRATION=false

# KLIPY GIF search (server-side only). Set this on the Convex deployment:
#   npx convex env set KLIPY_API_KEY <key>
# Never expose this key through a VITE_ variable or the browser bundle.
KLIPY_API_KEY=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
